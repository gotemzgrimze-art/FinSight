DATABASE_URL=postgres://postgres:postgres@localhost:5432/finsight
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Optional email provider. Development logs verification/reset links to the server console.
EMAIL_PROVIDER=console
EMAIL_FROM=security@finsight.local

# Optional third-party analytics. Do not send sensitive financial amounts.
ANALYTICS_PROVIDER=console

# Optional future integrations. Leave unset for local development.
BANK_PROVIDER=mock
IDENTITY_PROVIDER=none
